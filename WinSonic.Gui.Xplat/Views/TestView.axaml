<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WinSonic.Gui.Common.ViewModels;assembly=WinSonic.Gui.Common"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:TestViewModel"
             x:Class="WinSonic.Gui.Xplat.Views.TestView">
    <Design.DataContext>
         <viewModels:TestViewModel />
    </Design.DataContext>
    <StackPanel>
        <Button Command="{Binding LoadDataCommand}"></Button>
        <ListBox ItemsSource="{Binding Playlists}"></ListBox>
    </StackPanel>
</ContentPage>
