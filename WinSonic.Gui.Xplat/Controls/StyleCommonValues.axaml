<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    
    
    <!-- Font Sizes -->
    <sys:Double x:Key="WsFontSizeXs">9</sys:Double>
    <sys:Double x:Key="WsFontSizeSmall">10</sys:Double>
    <sys:Double x:Key="WsFontSizeSemiSmall">12</sys:Double>
    <sys:Double x:Key="WsFontSizeMedium">14</sys:Double>
    <sys:Double x:Key="WsFontSizeSemiLarge">16</sys:Double>
    <sys:Double x:Key="WsFontSizeLarge">18</sys:Double>
    <sys:Double x:Key="WsFontSizeXl">20</sys:Double>
    <sys:Double x:Key="WsFontSizeXxl">24</sys:Double>
    <sys:Double x:Key="WsFontSizeHero">40</sys:Double>
</ResourceDictionary>
