<Page x:Class="WinSonic.Gui.Pages.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WinSonic.Gui.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="ConsolePage" Height="450" Width="800" Loaded="ConsolePage_OnLoaded" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="Console Output"/>
        <ui:TextBox IsTextSelectionEnabled="False" TextWrapping="Wrap" x:Name="ConsoleOutput"  AcceptsReturn="True" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Margin="8" ></ui:TextBox>
    </Grid>
</Page>
