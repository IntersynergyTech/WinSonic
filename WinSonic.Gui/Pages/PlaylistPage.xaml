<Page x:Class="WinSonic.Gui.Pages.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WinSonic.Gui.Pages"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=local:PlaylistPage, IsDesignTimeCreatable=True}"
      Title="PlaylistPage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Text="Playlist Content"></TextBlock>
        <TextBlock Text="{Binding PlaylistFull.Name}"></TextBlock>
        <TextBlock Text="{Binding PlaylistFull.Id}"></TextBlock>
    </StackPanel>
</Page>
