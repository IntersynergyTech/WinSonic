<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0-macos</TargetFramework>
        <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <RootNamespace>WinSonic.Gui.Xplat.Mac</RootNamespace>
        <ApplicationId>WinSonic</ApplicationId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
        <PackageReference Include="HotAvalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WinSonic.Gui.Xplat\WinSonic.Gui.Xplat.csproj"/>
    </ItemGroup>
</Project>
